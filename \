char *wrap_text_by_words(char text[], int width)
{
    int i, line, last_space;
    i = line = last_space = 0;
    while (text[line * width + i])
    {
        printf("i: %i\n", i);
        printf("line: %i\n", line);
        printf("last_space: %i\n", last_space);
        printf("text at %i: %c\n", i, text[line * width + i]);
        if (i > width)
        {
            text[last_space] = '\n';
            i = 0;
            line++;
        }
        else if (text[line * width + i] == ' ')
        {
            last_space = line * width + i;
        }
        i++;
    }

    return text;
}
